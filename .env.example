# Leave DATABASE_URL unset to use the local SQLite database in .data/autoflow.sqlite.
DATABASE_URL=
# Optional: preserve this value between deployments to encrypt integration credentials consistently.
AUTOFLOW_CREDENTIALS_KEY=
PORT=3001
HOST=127.0.0.1
# Set to the public browser origin when deploying, for example https://app.example.com
PUBLIC_ORIGIN=
# Set true only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
